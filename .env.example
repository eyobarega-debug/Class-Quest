# ==========================================
# ClassQuest environment variables
# Copy this file to backend/.env and fill in real values.
# NEVER commit the real .env file to GitHub.
# ==========================================

# Port the Express server listens on
PORT=5000

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/classquest

# Secret used to sign JWT tokens. Use a long random string in production.
# You can generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Allowed origin for the frontend (CORS)
CLIENT_URL=http://localhost:5173

# --- Added in later phases, not needed for Phase 1 ---
# CODE_EXECUTION_API_URL=
# CODE_EXECUTION_API_KEY=
